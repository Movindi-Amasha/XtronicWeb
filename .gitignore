# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma sqlite dev db
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# product demo videos — hosted on Cloudinary instead (see lib/productImages.ts),
# since GitHub rejects files over 100MB and Vercel doesn't fetch Git LFS
# content during build. Drop a file here for local testing only; it's
# gitignored so it can never accidentally get committed again.
public/products/**/video.mp4
public/products/**/video.webm
public/products/**/video.mov
